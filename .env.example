# Copy to .env. Read by the app (SvelteKit) and docker compose.

# "dev" on a development site: shows a banner, tints the colours, uses the dev favicon and dev cookie names, and blocks search engines. Anything else (or unset) is prod.
APP_ENV=prod
# The dev site uses its own database so its writes never touch live data. Create it, then run prisma migrate deploy against it.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5434/clubpredict_dev

# Who may sign in: comma-separated domains and/or exact emails. "*" = anyone (dev only).
ALLOWED_EMAIL_DOMAINS=example.test
ALLOWED_EMAILS=

# Port for `npm run dev` (default 5173) and `npm run preview` (default 4173).
PORT=5173

# Postgres the app, tests and Prisma CLI connect to in dev. Unset = the compose db below (password "postgres" unless POSTGRES_PASSWORD is set).
# DATABASE_URL=postgresql://postgres:postgres@localhost:5434/clubpredict

# Google sign-in. Shown only when enabled AND both ID and secret are set; otherwise members use email + code.
GOOGLE_SIGNIN_ENABLED=true
# Client: console.cloud.google.com > Credentials > OAuth client, type "Web application".
# Authorised redirect URI: <origin>/login/google/callback, e.g. http://localhost:5173/login/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SSE website roster sync (src/sse/sync.ts): mirrors members, mentors and officers into sse_members. Unset = off.
SSE_API_URL=
# Bearer token for SSE endpoints that need a login (optional), and the User-Agent the sync identifies itself with.
SSE_API_TOKEN=
SSE_USER_AGENT=Monoglarket-sync
SSE_SYNC_MINUTES=15
# Currency (currencies.code) that SSE memberships, SSE check-ins and this site's events pay out in. Rates: earn_rules table.
SITE_CURRENCY=DBLN
# Bearer token for https://api.rit.edu (graduation term numbers). Optional.
RIT_API_KEY=
# GitHub token (no scopes) so GitHub checks get 5000 requests/hour instead of 60. Optional.
GITHUB_TOKEN=
# Where saved profile pictures go (sse-images/ inside it). Default ./data; the container uses a volume.
# DATA_DIR=data

# Connect LinkedIn on the account page (stores the member's LinkedIn id on their SSE row). Optional.
# App: linkedin.com/developers > Create app > Products: "Sign In with LinkedIn using OpenID Connect".
# Authorized redirect URL: <origin>/account/linkedin/callback, e.g. http://localhost:5173/account/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Connect GitHub on the account page (proves the member owns the GitHub account on their SSE profile; no token is kept). Optional.
# App: github.com/settings/developers > New OAuth App. Authorization callback URL: <origin>/account/github/callback
# (one URL per app, so use a separate app for local dev, e.g. http://localhost:5173/account/github/callback).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Connect Discord on the account page (profile, Discord email, connections; tokens kept for future linked roles). Optional.
# App: discord.com/developers/applications > OAuth2: add redirect <origin>/account/discord/callback.
# DISCORD_TOKEN_KEY encrypts the stored tokens: openssl rand -base64 32. Keep it stable; a new key orphans stored tokens.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_TOKEN_KEY=

# Web push alerts on phones and browsers. Generate the keys once with: npx web-push generate-vapid-keys
# VAPID_SUBJECT is a mailto: address the push services can reach. Leave all three blank to turn alerts off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Outgoing email. Leave SMTP_URL empty in dev: sign-in emails are printed to the server console.
SMTP_URL=
MAIL_FROM=Monoglarket <no-reply@example.org>

# Production (docker compose). The deploy sets APP_IMAGE itself (scripts/deploy.sh); don't put it here.
# DOMAIN is the public host name. Caddy gets the HTTPS certificate for it, so DNS must point at the host first.
DOMAIN=localhost
# Host port for the compose Postgres (dev connects here; the app container uses the internal network).
POSTGRES_PORT=5434
POSTGRES_PASSWORD=change-me
