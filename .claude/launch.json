{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "dev-site",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "APP_ENV=dev DATABASE_URL=postgresql://postgres:postgres@localhost:5434/clubpredict_dev npm run dev -- --port 5174 --strictPort"
      ],
      "port": 5174
    },
    {
      "name": "design-review",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "ALLOWED_EMAIL_DOMAINS=example.test npm run dev -- --port 5175 --strictPort"
      ],
      "port": 5175
    }
  ]
}
